      >
    </div>
  </div>

  <!-- Navigation Links (Dynamic per role) -->
  <nav class="flex-1 overflow-y-auto overflow-x-hidden px-3 py-4 space-y-1" id="sidebar-nav-container">
    <button onclick="navigateToView('dashboard')" title="Dashboard" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs transition-colors bg-brand-600 text-white font-semibold shadow-xs" aria-current="page">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
      <span class="sidebar-label truncate">Dashboard</span>
    </button>

    <button onclick="navigateToView('empleados')" title="Empleados" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs transition-colors text-slate-700 hover:bg-slate-200/70 hover:text-slate-950 font-medium" aria-current="false">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      <span class="sidebar-label truncate">Empleados</span>
    </button>

    <button onclick="navigateToView('reuniones')" title="Reuniones COPASST" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs transition-colors text-slate-700 hover:bg-slate-200/70 hover:text-slate-950 font-medium" aria-current="false">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
      <span class="sidebar-label truncate">Reuniones COPASST</span>
    </button>

    <button onclick="navigateToView('actas')" title="Actas" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs transition-colors text-slate-700 hover:bg-slate-200/70 hover:text-slate-950 font-medium" aria-current="false">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
      <span class="sidebar-label truncate">Actas</span>
    </button>

    <button onclick="navigateToView('capacitaciones')" title="Capacitaciones" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs transition-colors text-slate-700 hover:bg-slate-200/70 hover:text-slate-950 font-medium" aria-current="false">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
      <span class="sidebar-label truncate">Capacitaciones</span>
    </button>

    <button onclick="navigateToView('autorreporte')" title="Autorreporte" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs transition-colors text-slate-700 hover:bg-slate-200/70 hover:text-slate-950 font-medium" aria-current="false">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
      <span class="sidebar-label truncate">Autorreporte</span>
    </button>
  </nav>

  <!-- Sidebar Footer / Legal Compliance Badge -->
  <div class="p-4 border-t border-slate-200/80 bg-black/5 transition-all duration-300" id="sidebar-footer" data-purpose="compliance-widget">
    <div class="flex items-center justify-between text-xs mb-1.5">
      <span class="font-bold text-slate-900">Cumplimiento Legal</span>
      <span class="font-bold text-teal-600" id="compliance-percentage">94.2%</span>
    </div>
    <div class="w-full bg-slate-300/80 rounded-full h-1.5 overflow-hidden">
      <div class="bg-teal-600 h-1.5 rounded-full" style="width: 94.2%;"></div>
    </div>
    <div class="mt-2 flex items-center justify-between text-[11px] font-semibold text-slate-900">
      <span>Estándares mínimos</span>
      <span class="text-emerald-700 font-bold">Conforme</span>
    </div>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('main-sidebar');
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const headerControls = document.getElementById('sidebar-header-controls');
    const logoWrapper = document.getElementById('sidebar-logo-wrapper');
    const sidebarFooter = document.getElementById('sidebar-footer');
    const labels = document.querySelectorAll('.sidebar-label');
    const navItems = document.querySelectorAll('.nav-item');

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;

      // 1. Actualizar estado ARIA
      toggleBtn.setAttribute('aria-expanded', String(nextState));

      // 2. Alternar ancho del contenedor principal (w-64 = 256px vs w-20 = 80px)
      sidebar.classList.toggle('w-64', nextState);
      sidebar.classList.toggle('w-20', !nextState);

      // 3. Centrar el botón hamburguesa cuando está colapsado
      headerControls.classList.toggle('justify-end', nextState);
      headerControls.classList.toggle('justify-center', !nextState);

      // 4. Ocultar textos, logo grande y widget inferior al colapsar
      labels.forEach(label => label.classList.toggle('hidden', !nextState));
      logoWrapper.classList.toggle('hidden', !nextState);
      sidebarFooter.classList.toggle('hidden', !nextState);

      // 5. Centrar los íconos de navegación en modo mini-rail
      navItems.forEach(item => {
        item.classList.toggle('justify-center', !nextState);
      });
    });
  });
</script>

<!-- END: Sidebar Navigation -->
<!-- BEGIN: Main Content Area -->
<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
<!-- BEGIN: Topbar Header -->
<header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between flex-shrink-0 z-20 shadow-xs" data-purpose="topbar-header" style="border-color: rgb(229, 226, 221);">
<!-- Saludo Dinámico & Mobile menu trigger -->
