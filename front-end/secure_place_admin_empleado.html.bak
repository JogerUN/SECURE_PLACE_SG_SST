<!DOCTYPE html><html class="h-full bg-slate-50" lang="es"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
<title>Secure Place | SG-SST Colombia</title>
<!-- BEGIN: External Tailwind CSS v3 -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- END: External Tailwind CSS v3 -->
<!-- BEGIN: Tailwind Configuration -->
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#F0FDFA',
              100: '#CCFBF1',
              500: '#14B8A6',
              600: '#0D9488',
              700: '#0F766E',
              800: '#115E59',
              900: '#134E4A'
            },
            charcoal: {
              700: '#334155',
              800: '#1E293B',
              900: '#0F172A'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif']
          }
        }
      }
    }
  </script>
<!-- END: Tailwind Configuration -->
<!-- BEGIN: Custom Styling for Layout and Transitions -->
<style data-purpose="layout-and-transitions">
    /* Custom scrollbars for high density dashboard panels */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F1F5F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }
    
    /* Interactive accessible outline focus */
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
      outline: 2px solid #0D9488;
      outline-offset: 2px;
    }
    
    .badge-status {
      display: inline-flex;
      align-items: center;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1rem;
    }
  </style>
<!-- END: Custom Styling for Layout and Transitions -->
</head>
<body class="h-full text-slate-800 antialiased font-sans flex flex-col bg-slate-100 selection:bg-brand-500 selection:text-white" style="font-family: &quot;Plus Jakarta Sans&quot;, sans-serif; background-color: rgb(246, 243, 238);">
<!-- BEGIN: Application Shell -->
<div class="flex h-screen overflow-hidden" data-purpose="app-shell">
<!-- BEGIN: Sidebar Navigation -->

<aside aria-label="Navegación principal" class="w-64 text-slate-800 border-r border-slate-200 flex flex-col flex-shrink-0 transition-all duration-300 z-30 overflow-hidden" id="main-sidebar" style="background-color: #fbf5e5;">
