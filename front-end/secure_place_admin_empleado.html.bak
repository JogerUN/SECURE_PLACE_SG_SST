        { id: 1, name: 'Juan Carlos Pérez', cargo: 'Operario de Planta', cc: '1.020.445.890', area: 'Producción', estado: 'Activo' },
        { id: 2, name: 'Elena Salazar M.', cargo: 'Líder de Almacén', cc: '52.341.908', area: 'Logística', estado: 'Activo' },
        { id: 3, name: 'Andrés Felipe Castro', cargo: 'Técnico de Mantenimiento', cc: '80.765.234', area: 'Operaciones', estado: 'Activo' },
        { id: 4, name: 'Diana Marcela Torres', cargo: 'Auxiliar Administrativa', cc: '1.014.238.901', area: 'Talento Humano', estado: 'Activo' },
        { id: 5, name: 'Roberto Camargo', cargo: 'Supervisor de Turno', cc: '79.654.112', area: 'Producción', estado: 'Activo' }
      ],
      autorreportes: [
        { id: 'AR-104', trabajador: 'Juan Carlos Pérez', categoria: 'Condición Insegura', localizacion: 'Bodega Central - Pasillo 3', fecha: '14/05/2025 08:30 AM', estado: 'Abierto', tipo: 'riesgo' },
        { id: 'AR-103', trabajador: 'Elena Salazar M.', categoria: 'Acto Inseguro', localizacion: 'Muelles de Carga', fecha: '12/05/2025 14:15 PM', estado: 'En revisión', tipo: 'riesgo' },
        { id: 'AR-102', trabajador: 'María Gómez', categoria: 'Incapacidad Médica (3 días)', localizacion: 'Oficina Central', fecha: '10/05/2025 09:00 AM', estado: 'Aprobado', tipo: 'incapacidad' },
        { id: 'AR-101', trabajador: 'Andrés Felipe Castro', categoria: 'Incidente Mecánico', localizacion: 'Taller Mecánico', fecha: '05/05/2025 11:20 AM', estado: 'Cerrado', tipo: 'riesgo' }
      ],
      calendarEvents: [
        { day: 5, month: 5, title: 'Inspección Extintores', type: 'inspeccion', label: 'Inspección' },
        { day: 12, month: 5, title: 'Charla Prevención Ruido', type: 'capacitacion', label: 'Capacitación' },
        { day: 16, month: 5, title: 'Taller Manejo Fuego', type: 'capacitacion', label: 'Capacitación' },
        { day: 22, month: 5, title: 'Reunión Ordinaria COPASST', type: 'copasst', label: 'COPASST' },
        { day: 27, month: 5, title: 'Trabajo en Alturas', type: 'capacitacion', label: 'Capacitación' }
      ]
    };

    // Role Navigation Maps
    const navItemsAdmin = [
      { id: 'dashboard', label: 'Dashboard', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>' },
      { id: 'empleados', label: 'Empleados', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>' },
      { id: 'reuniones', label: 'Reuniones COPASST', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>' },
      { id: 'actas', label: 'Actas', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>' },
      { id: 'capacitaciones', label: 'Capacitaciones', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>' },
      { id: 'autorreporte', label: 'Autorreporte', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>' }
    ];

    const navItemsEmployee = [
      { id: 'dashboard', label: 'Dashboard', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>' },
      { id: 'actas', label: 'Actas (Consulta)', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>' },
      { id: 'autorreporte', label: 'Mi Autorreporte', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>' }
    ];

    // Initialization
    document.addEventListener('DOMContentLoaded', () => {
      renderNavigation();
      renderCalendarDays();
      renderEmployeeList();
      renderAutorreportesTable();
      updateTopBarProfile();

      // Mobile sidebar trigger
      document.getElementById('mobile-menu-btn').addEventListener('click', () => {
        document.getElementById('main-sidebar').classList.toggle('-translate-x-full');
      });
    });

    // Switch Role Function
    function switchRole(newRole) {
      state.currentRole = newRole;
      
      const adminBtn = document.getElementById('role-admin-btn');
      const employeeBtn = document.getElementById('role-employee-btn');
      
      if (newRole === 'admin') {
        adminBtn.className = "px-3 py-1.5 text-xs font-semibold rounded-md shadow-xs bg-white text-brand-700 transition-colors";
        adminBtn.setAttribute('aria-pressed', 'true');
        employeeBtn.className = "px-3 py-1.5 text-xs font-semibold rounded-md text-slate-600 hover:text-slate-900 transition-colors";
        employeeBtn.setAttribute('aria-pressed', 'false');
      } else {
        employeeBtn.className = "px-3 py-1.5 text-xs font-semibold rounded-md shadow-xs bg-white text-brand-700 transition-colors";
        employeeBtn.setAttribute('aria-pressed', 'true');
        adminBtn.className = "px-3 py-1.5 text-xs font-semibold rounded-md text-slate-600 hover:text-slate-900 transition-colors";
        adminBtn.setAttribute('aria-pressed', 'false');
      }

      updateTopBarProfile();
      renderNavigation();

      // Adapt views based on role
      if (newRole === 'employee') {
        document.getElementById('dashboard-kpis-admin').classList.add('hidden');
        document.getElementById('dashboard-kpis-employee').classList.remove('hidden');
        document.getElementById('acta-upload-panel').classList.add('hidden');
        document.getElementById('acta-viewer-column').className = "lg:col-span-8 bg-white rounded-xl border border-slate-200 shadow-xs p-6 flex flex-col justify-between";
        document.getElementById('autorreportes-table-heading').innerText = "Lista de Autorreportes DEL EMPLEADO (Historial)";
        
        // If on an admin-exclusive view, redirect to dashboard
        if (state.currentView === 'empleados' || state.currentView === 'reuniones' || state.currentView === 'capacitaciones') {
          navigateToView('dashboard');
        }
      } else {
        document.getElementById('dashboard-kpis-admin').classList.remove('hidden');
        document.getElementById('dashboard-kpis-employee').classList.add('hidden');
        document.getElementById('acta-upload-panel').classList.remove('hidden');
        document.getElementById('acta-viewer-column').className = "lg:col-span-5 bg-white rounded-xl border border-slate-200 shadow-xs p-6 flex flex-col justify-between";
        document.getElementById('autorreportes-table-heading').innerText = "Lista de Autorreportes de TODOS los Empleados";
      }

      renderAutorreportesTable();
    }

    function updateTopBarProfile() {
      const activeUser = state.users[state.currentRole];
      document.getElementById('user-greeting').innerText = activeUser.greeting;
      document.getElementById('user-role-label').innerText = activeUser.roleLabel;
      document.getElementById('user-avatar').innerText = activeUser.initials;
      document.getElementById('user-name-short').innerText = activeUser.shortName;
      document.getElementById('trabajador-nombre-input').value = `${activeUser.fullName} (C.C. ${activeUser.cedula}) - ${state.currentRole === 'admin' ? 'Administrador SST' : 'Operario'}`;
    }

    function renderNavigation() {
      const container = document.getElementById('sidebar-nav-container');
      const items = state.currentRole === 'admin' ? navItemsAdmin : navItemsEmployee;
      
      container.innerHTML = items.map(item => {
        const isActive = state.currentView === item.id;
        const activeClasses = isActive 
          ? 'bg-brand-600 text-white font-semibold shadow-xs' 
          : 'text-slate-300 hover:bg-slate-800 hover:text-white font-medium';
        return `
          <button onclick="navigateToView('${item.id}')" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs transition-colors ${activeClasses}" aria-current="${isActive ? 'page' : 'false'}">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">${item.icon}</svg>
            <span>${item.label}</span>
          </button>
        `;
      }).join('');
    }

    function navigateToView(viewId) {
      state.currentView = viewId;
      const views = ['dashboard', 'empleados', 'reuniones', 'actas', 'capacitaciones', 'autorreporte'];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (el) {
          if (v === viewId) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        }
      });
      renderNavigation();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Calendar Generation
    function renderCalendarDays(filter = 'all') {
      const container = document.getElementById('calendar-days-container');
      let html = '';
      
      // May 2025 starts on a Thursday (offset: 3 empty days from Monday)
      for (let i = 0; i < 3; i++) {
        html += `<div class="h-28 rounded-lg bg-slate-50/50 border border-slate-100 p-2 opacity-40"></div>`;
      }

      for (let day = 1; day <= 31; day++) {
        const event = state.calendarEvents.find(e => e.day === day);
        let eventBadge = '';
        
        if (event && (filter === 'all' || filter === event.type)) {
          let colorClass = 'bg-brand-600 text-white';
          if (event.type === 'capacitacion') colorClass = 'bg-amber-500 text-white';
          if (event.type === 'inspeccion') colorClass = 'bg-purple-600 text-white';

          eventBadge = `
            <div onclick="showDayEvent(${day}, '${event.title}', '${event.label}')" class="mt-1 p-1 rounded ${colorClass} text-[10px] font-bold truncate cursor-pointer hover:opacity-90 shadow-xs" title="${event.title}">
              ${event.title}
            </div>
          `;
        }

        const isToday = day === 14;
        html += `
          <div class="h-28 rounded-lg border ${isToday ? 'border-brand-500 bg-teal-50/20 ring-1 ring-brand-500' : 'border-slate-200 bg-white'} p-2 flex flex-col justify-between hover:shadow-xs transition-shadow">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold ${isToday ? 'text-brand-800 font-bold bg-brand-100 w-5 h-5 rounded-full flex items-center justify-center' : 'text-slate-600'}">${day}</span>
              ${isToday ? '<span class="text-[9px] font-bold text-brand-700 uppercase">Hoy</span>' : ''}
            </div>
            <div class="flex-1 overflow-hidden mt-1">
              ${eventBadge}
            </div>
          </div>
        `;
      }
      container.innerHTML = html;
    }

    function filterCalendar(category, btnElement) {
      const parent = btnElement.parentElement;
      Array.from(parent.querySelectorAll('button')).forEach(b => {
        b.className = "px-2.5 py-1 rounded text-slate-600 hover:text-slate-900 font-medium";
      });
      btnElement.className = "px-2.5 py-1 rounded bg-white font-medium text-slate-800 shadow-xs";
      renderCalendarDays(category);
    }

    function showDayEvent(day, title, label) {
      alert(`Detalle de Actividad SG-SST:\n\nEvento: ${title}\nFecha: ${day} de Mayo, 2025\nClasificación: ${label}\nAsistencia obligatoria con registro de quórum.`);
    }

    // Employees View Logic
    function renderEmployeeList() {
      const container = document.getElementById('employee-list-container');
      container.innerHTML = state.employees.map((emp, index) => `
        <div onclick="selectEmployee(${emp.id})" class="p-3.5 hover:bg-slate-50 cursor-pointer flex items-center justify-between transition-colors ${index === 0 ? 'bg-slate-50 border-l-4 border-brand-600' : ''}">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center">
              ${emp.name.split(' ').map(n=>n[0]).slice(0,2).join('')}
            </div>
            <div>
              <p class="text-xs font-bold text-slate-800">${emp.name}</p>
              <p class="text-[11px] text-slate-500">${emp.cargo} • ${emp.area}</p>
            </div>
          </div>
          <span class="badge-status bg-emerald-100 text-emerald-800 text-[10px]">${emp.estado}</span>
        </div>
      `).join('');
    }

    function selectEmployee(id) {
      const emp = state.employees.find(e => e.id === id);
      if (!emp) return;
      document.getElementById('emp-detail-name').innerText = emp.name;
      document.getElementById('emp-detail-role').innerText = `${emp.cargo} • C.C. ${emp.cc}`;
      document.getElementById('emp-detail-avatar').innerText = emp.name.split(' ').map(n=>n[0]).slice(0,2).join('');
    }

    function filterEmployeeTable(term) {
      const t = term.toLowerCase();
      const container = document.getElementById('employee-list-container');
      const filtered = state.employees.filter(e => e.name.toLowerCase().includes(t) || e.cc.includes(t) || e.cargo.toLowerCase().includes(t));
      container.innerHTML = filtered.map(emp => `
        <div onclick="selectEmployee(${emp.id})" class="p-3.5 hover:bg-slate-50 cursor-pointer flex items-center justify-between">
          <div>
            <p class="text-xs font-bold text-slate-800">${emp.name}</p>
            <p class="text-[11px] text-slate-500">${emp.cargo}</p>
          </div>
          <span class="badge-status bg-emerald-100 text-emerald-800 text-[10px]">${emp.estado}</span>
        </div>
      `).join('');
    }

    // Actas View Logic
    function selectActa(number) {
      const titles = {
        1: 'ACTA N° 001 - COPASST',
        2: 'ACTA N° 002 - COMITÉ CONVIVENCIA',
        3: 'ACTA N° 003 - REVISIÓN POR LA DIRECCIÓN'
      };
      const statuses = {
        1: { text: 'Aprobada', class: 'bg-emerald-100 text-emerald-800' },
        2: { text: 'En proceso', class: 'bg-amber-100 text-amber-800' },
        3: { text: 'Aprobada', class: 'bg-emerald-100 text-emerald-800' }
      };

      document.getElementById('viewer-title').innerText = titles[number];
      const badge = document.getElementById('viewer-status-badge');
      badge.innerText = statuses[number].text;
      badge.className = `badge-status font-bold ${statuses[number].class}`;
    }

    function simulateAudioUpload(input) {
      if (input.files && input.files[0]) {
        document.getElementById('upload-status-box').classList.remove('hidden');
        document.getElementById('upload-status-box').innerText = `Archivo cargado: ${input.files[0].name} (Listo para transcripción)`;
      }
    }

    function simulateTranscription() {
      alert('Iniciando servicio de IA: Transcribiendo audio, detectando compromisos y asociando nombres de los miembros del COPASST...');
      setTimeout(() => {
        alert('Transcripción finalizada: Borrador de Acta generado exitosamente en pantalla.');
        selectActa(2);
      }, 1000);
    }

    // Autorreportes Logic
    function renderAutorreportesTable(filterStatus = 'all') {
      const tbody = document.getElementById('reports-tbody');
      
      let items = state.autorreportes;
      if (state.currentRole === 'employee') {
        // Only show employee's own reports
        items = items.filter(r => r.trabajador === 'María Gómez');
      }

      if (filterStatus !== 'all') {
        items = items.filter(r => r.estado.toLowerCase().includes(filterStatus.toLowerCase()));
      }

      if (items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center p-6 text-slate-400">No se encontraron reportes radicados con los filtros seleccionados.</td></tr>`;
        return;
      }

      tbody.innerHTML = items.map(r => {
        let badgeColor = 'bg-blue-100 text-blue-800';
        if (r.estado === 'En revisión') badgeColor = 'bg-amber-100 text-amber-800';
        if (r.estado === 'En plan de acción') badgeColor = 'bg-purple-100 text-purple-800';
        if (r.estado === 'Cerrado') badgeColor = 'bg-emerald-100 text-emerald-800';
        if (r.estado === 'Aprobado') badgeColor = 'bg-emerald-100 text-emerald-800';
        if (r.estado === 'Rechazado') badgeColor = 'bg-rose-100 text-rose-800';

        return `
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3 font-mono font-bold text-slate-800">${r.id}</td>
            <td class="p-3 font-medium text-slate-800">${r.trabajador}</td>
            <td class="p-3 text-slate-600">${r.categoria}</td>
            <td class="p-3 text-slate-500">${r.localizacion}</td>
            <td class="p-3 text-slate-500">${r.fecha}</td>
            <td class="p-3">
              <span class="badge-status ${badgeColor}">${r.estado}</span>
            </td>
            <td class="p-3 text-right">
              <button onclick="alert('Detalle completo del caso ${r.id}:\\nReportante: ${r.trabajador}\\nLocalización: ${r.localizacion}\\nEstado actual: ${r.estado}\\nAcción de SST: Inspección programada.')" class="text-xs text-brand-600 hover:text-brand-800 font-semibold">Ver Ficha</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterReportsByStatus(val) {
      renderAutorreportesTable(val);
    }

    function toggleReportTypeFields(type) {
      if (type === 'incapacidades') {
        document.getElementById('fields-incapacidades').classList.remove('hidden');
        document.getElementById('fields-riesgos').classList.add('hidden');
      } else {
        document.getElementById('fields-riesgos').classList.remove('hidden');
        document.getElementById('fields-incapacidades').classList.add('hidden');
      }
    }

    function openReportModal() {
      document.getElementById('modal-autorreporte').classList.remove('hidden');
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      document.getElementById('fecha-evento-input').value = now.toISOString().slice(0,16);
    }

    function closeReportModal() {
      document.getElementById('modal-autorreporte').classList.add('hidden');
    }

    function previewEvidenceFile(input) {
      if (input.files && input.files[0]) {
        document.getElementById('evidence-filename').innerText = `Adjuntado: ${input.files[0].name}`;
      }
    }

    function handleFormReportSubmit(e) {
      e.preventDefault();
      const activeUser = state.users[state.currentRole];
      const categoryType = document.querySelector('input[name="report_category"]:checked').value;
      
      let categoryName = '';
      let localizacion = '';

      if (categoryType === 'riesgos') {
        categoryName = document.getElementById('tipo-riesgo-select').value;
        localizacion = document.getElementById('localizacion-input').value;
      } else {
        const dias = document.getElementById('dias-otorgados-input').value || 1;
        categoryName = `Incapacidad Médica (${dias} días)`;
        localizacion = 'Domicilio / EPS';
      }

      const newId = `AR-${100 + state.autorreportes.length + 1}`;
      const now = new Date();
      const formattedDate = `${now.getDate().toString().padStart(2,'0')}/${(now.getMonth()+1).toString().padStart(2,'0')}/${now.getFullYear()} ${now.getHours()}:${now.getMinutes().toString().padStart(2,'0')}`;

      const newReport = {
        id: newId,
        trabajador: activeUser.fullName,
        categoria: categoryName,
        localizacion: localizacion,
        fecha: formattedDate,
        estado: 'Abierto',
        tipo: categoryType
      };

      state.autorreportes.unshift(newReport);
      closeReportModal();
      renderAutorreportesTable();
      navigateToView('autorreporte');
      alert(`¡Autorreporte radicado con éxito!\nNúmero de radicado oficial: ${newId}\nSe ha notificado al área de Seguridad y Salud en el Trabajo.`);
    }

    function toggleNotifications() {
      const menu = document.getElementById('notif-menu');
      menu.classList.toggle('hidden');
    }

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }
  </script>
<!-- END: Application State & Routing JavaScript -->










</body></html>