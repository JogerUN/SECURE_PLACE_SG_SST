              Administrador
            </button>
<button aria-pressed="false" class="px-3 py-1.5 text-xs font-semibold rounded-md transition-colors text-slate-600 hover:text-slate-900" id="role-employee-btn" onclick="switchRole('employee')" type="button">
              Empleado
            </button>
</div>
<!-- Notification Bell with Dropdown Preview -->
<div class="relative" data-purpose="notifications-center">
<button aria-label="Ver 2 notificaciones nuevas" class="p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-full relative" id="notif-toggle-btn" onclick="toggleNotifications()">
<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
<span class="absolute top-1 right-1 w-2.5 h-2.5 bg-rose-500 border-2 border-white rounded-full"></span>
</button>
<!-- Dropdown content -->
<div class="hidden absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl border border-slate-200 py-2 z-50" id="notif-menu">
<div class="px-4 py-2 border-b border-slate-100 font-semibold text-xs text-slate-700 uppercase tracking-wider">Alertas SG-SST Prioritarias</div>
<div class="divide-y divide-slate-100 max-h-64 overflow-y-auto">
<a class="block px-4 py-2.5 hover:bg-slate-50 text-left" href="javascript:void(0)" onclick="navigateToView('autorreporte'); toggleNotifications();">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-amber-500"></span>
<p class="text-xs font-semibold text-slate-800">Nuevo autorreporte radicado #AR-104</p>
</div>
<p class="text-[11px] text-slate-500 pl-4 mt-0.5">Reporte de condición insegura en Bodega Central.</p>
</a>
<a class="block px-4 py-2.5 hover:bg-slate-50 text-left" href="javascript:void(0)" onclick="navigateToView('reuniones'); toggleNotifications();">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-brand-500"></span>
