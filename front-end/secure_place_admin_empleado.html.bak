<!-- BEGIN: MODAL - GENERAR AUTORREPORTE (Image 5 & Image 1 specs)     -->
<!-- ================================================================= -->
<div aria-labelledby="modal-report-title" aria-modal="true" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto" id="modal-autorreporte" role="dialog">
<div class="bg-white rounded-2xl max-w-2xl w-full shadow-2xl border border-slate-200 overflow-hidden my-8">
<!-- Modal Header -->
<div class="p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
<div>
<h3 class="text-base font-bold text-slate-800" id="modal-report-title">Radicar Nuevo Autorreporte SG-SST</h3>
<p class="text-xs text-slate-500">Diligencie la información verídica para gestión inmediata de SST</p>
</div>
<button class="text-slate-400 hover:text-slate-700 p-1 rounded-lg" onclick="closeReportModal()">
<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
</div>
<!-- Modal Form Body -->
<form class="p-6 space-y-4" id="form-autorreporte" onsubmit="handleFormReportSubmit(event)">
<!-- Tab Switcher: [ Riesgos y accidentes ] vs [ Incapacidades ] -->
<div>
<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Seleccione Tipo de Reporte *</label>
<div class="grid grid-cols-2 gap-3">
<label class="flex items-center justify-center gap-2 p-3 border-2 border-brand-500 bg-brand-50/40 rounded-xl cursor-pointer font-semibold text-xs text-brand-900 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
<input checked="" class="text-brand-600 focus:ring-brand-500" name="report_category" onchange="toggleReportTypeFields('riesgos')" type="radio" value="riesgos">
<span>⚠️ Riesgos y Accidentes</span>
</label>
<label class="flex items-center justify-center gap-2 p-3 border border-slate-200 rounded-xl cursor-pointer font-semibold text-xs text-slate-700 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
<input class="text-brand-600 focus:ring-brand-500" name="report_category" onchange="toggleReportTypeFields('incapacidades')" type="radio" value="incapacidades">
<span>🏥 Incapacidades Médicas</span>
</label>
</div>
</div>
<!-- Conditional Fields: Riesgos y Accidentes -->
<div class="space-y-4" id="fields-riesgos">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="tipo-riesgo-select">Clasificación del Evento *</label>
<select class="w-full text-xs rounded-lg border-slate-300 focus:border-brand-500 focus:ring-brand-500" id="tipo-riesgo-select">
<option value="Condición Insegura">Condición Insegura (Peligro locativo/físico)</option>
<option value="Acto Inseguro">Acto Inseguro</option>
<option value="Casi-accidente (Incidente)">Casi-accidente / Incidente sin lesión</option>
<option value="Accidente de Trabajo Leve">Accidente de Trabajo Leve</option>
<option value="Accidente de Trabajo Grave">Accidente de Trabajo Grave</option>
</select>
</div>
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="localizacion-input">Localización Exacta *</label>
<input class="w-full text-xs rounded-lg border-slate-300 focus:border-brand-500" id="localizacion-input" placeholder="Ej: Planta 2, Línea de envasado, Pasillo 4" required="" type="text">
</div>
</div>
</div>
<!-- Conditional Fields: Incapacidades -->
<div class="space-y-4 hidden" id="fields-incapacidades">
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="origen-incapacidad-select">Origen de la Incapacidad *</label>
<select class="w-full text-xs rounded-lg border-slate-300" id="origen-incapacidad-select">
<option value="Enfermedad General">Enfermedad General (EPS)</option>
<option value="Accidente de Trabajo">Accidente de Trabajo (ARL)</option>
<option value="Enfermedad Laboral">Enfermedad Laboral Calificada</option>
<option value="Licencia Maternidad/Paternidad">Licencia de Maternidad / Paternidad</option>
</select>
</div>
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="cie10-input">Diagnóstico CIE-10</label>
<input class="w-full text-xs rounded-lg border-slate-300" id="cie10-input" placeholder="Ej: J00, M54.5" type="text">
</div>
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="dias-otorgados-input">Días Otorgados *</label>
<input class="w-full text-xs rounded-lg border-slate-300" id="dias-otorgados-input" max="180" min="1" placeholder="Ej: 3" type="number">
</div>
</div>
</div>
<!-- Common Fields: Descripción, Fecha/Hora, Datos del Trabajador -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="fecha-evento-input">Fecha y Hora del Evento / Inicio *</label>
<input class="w-full text-xs rounded-lg border-slate-300 focus:border-brand-500" id="fecha-evento-input" required="" type="datetime-local">
</div>
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="trabajador-nombre-input">Datos del Trabajador Reportante *</label>
<input class="w-full text-xs rounded-lg bg-slate-100 border-slate-300 text-slate-600" id="trabajador-nombre-input" readonly="" type="text" value="Carlos Rodríguez (C.C. 1.019.234.567) - Administrador SST">
</div>
</div>
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1" for="descripcion-reporte-input">Descripción Detallada *</label>
<textarea class="w-full text-xs rounded-lg border-slate-300 focus:border-brand-500" id="descripcion-reporte-input" placeholder="Describa de manera clara qué observó, partes corporales afectadas o causas de la condición de peligro..." required="" rows="3"></textarea>
</div>
<!-- Evidencia (Foto / Soporte Médico) -->
<div>
<label class="block text-xs font-semibold text-slate-700 mb-1">Evidencia Fotográfica o Soporte PDF *</label>
<div class="border border-dashed border-slate-300 rounded-lg p-3 text-center hover:bg-slate-50 cursor-pointer" onclick="document.getElementById('evidence-file-input').click()">
<svg class="w-6 h-6 mx-auto text-slate-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path><path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
<span class="text-xs text-brand-700 font-semibold" id="evidence-filename">Haga clic para adjuntar foto o certificado</span>
<input class="hidden" id="evidence-file-input" onchange="previewEvidenceFile(this)" type="file">
</div>
</div>
<!-- Footer Actions -->
<div class="pt-3 border-t border-slate-200 flex justify-end gap-3">
<button class="px-4 py-2 border border-slate-300 text-xs font-semibold rounded-lg text-slate-700 hover:bg-slate-50" onclick="closeReportModal()" type="button">Cancelar</button>
<button class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs rounded-lg shadow-sm" type="submit">Radicar Reporte</button>
</div>
</form>
</div>
</div>
<!-- END: MODAL - GENERAR AUTORREPORTE -->
<!-- BEGIN: MODAL - AGENDAR REUNION COPASST -->
<div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4" id="modal-agendar-reunion">
<div class="bg-white rounded-xl max-w-md w-full p-5 border border-slate-200 shadow-2xl">
<h3 class="text-sm font-bold text-slate-800 mb-3">Agendar Convocatoria COPASST</h3>
<form class="space-y-3 text-xs" onsubmit="event.preventDefault(); closeModal('modal-agendar-reunion'); alert('Reunión agendada y notificaciones enviadas a los miembros del comité.');">
<div>
<label class="block font-semibold mb-1">Tipo de Reunión</label>
<select class="w-full rounded-lg border-slate-300 text-xs"><option>Ordinaria Mensual</option><option>Extraordinaria (Investigación AT)</option></select>
</div>
<div>
<label class="block font-semibold mb-1">Fecha y Hora</label>
<input class="w-full rounded-lg border-slate-300 text-xs" required="" type="datetime-local">
</div>
<div>
<label class="block font-semibold mb-1">Lugar o Enlace Virtual</label>
<input class="w-full rounded-lg border-slate-300 text-xs" placeholder="Ej: Sala de juntas o link Teams" required="" type="text">
</div>
<div>
<label class="block font-semibold mb-1">Orden del Día</label>
<textarea class="w-full rounded-lg border-slate-300 text-xs" placeholder="Temas a tratar..." rows="2"></textarea>
</div>
<div class="flex justify-end gap-2 pt-2 border-t">
<button class="px-3 py-1.5 border rounded" onclick="closeModal('modal-agendar-reunion')" type="button">Cancelar</button>
<button class="px-3 py-1.5 bg-brand-600 text-white rounded font-semibold" type="submit">Guardar y Convocar</button>
</div>
</form>
</div>
</div>
<!-- END: MODAL - AGENDAR REUNION COPASST -->
<!-- BEGIN: MODAL - AGENDAR CAPACITACION -->
<div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4" id="modal-agendar-capacitacion">
<div class="bg-white rounded-xl max-w-md w-full p-5 border border-slate-200 shadow-2xl">
<h3 class="text-sm font-bold text-slate-800 mb-3">Agendar Sesión de Capacitación</h3>
<form class="space-y-3 text-xs" onsubmit="event.preventDefault(); closeModal('modal-agendar-capacitacion'); alert('Capacitación agregada al cronograma del SG-SST.');">
<div>
<label class="block font-semibold mb-1">Tema Técnico</label>
<input class="w-full rounded-lg border-slate-300 text-xs" placeholder="Ej: Manejo de Sustancias Químicas" required="" type="text">
</div>
<div>
<label class="block font-semibold mb-1">Fecha y Horario</label>
<input class="w-full rounded-lg border-slate-300 text-xs" required="" type="datetime-local">
</div>
<div>
<label class="block font-semibold mb-1">Encargado / Facilitador</label>
<input class="w-full rounded-lg border-slate-300 text-xs" placeholder="Ej: Especialista ARL / Asesor Externo" required="" type="text">
</div>
<div class="flex justify-end gap-2 pt-2 border-t">
<button class="px-3 py-1.5 border rounded" onclick="closeModal('modal-agendar-capacitacion')" type="button">Cancelar</button>
<button class="px-3 py-1.5 bg-brand-600 text-white rounded font-semibold" type="submit">Publicar</button>
</div>
</form>
</div>
</div>
<!-- END: MODAL - AGENDAR CAPACITACION -->
<!-- BEGIN: Application State & Routing JavaScript -->
