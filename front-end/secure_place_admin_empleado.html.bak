<p class="text-xs text-slate-500">Cronograma de actividades preventivas y reuniones</p>
</div>
</div>
<!-- Filters & Month Selection -->
<div class="flex flex-wrap items-center gap-3">
<!-- Event Category Filter -->
<div class="flex items-center bg-slate-100 rounded-lg p-1 text-xs">
<span class="text-slate-500 px-2 font-medium">Filtrar:</span>
<button class="px-2.5 py-1 rounded bg-white font-medium text-slate-800 shadow-xs" onclick="filterCalendar('all', this)" type="button">Todos</button>
<button class="px-2.5 py-1 rounded text-slate-600 hover:text-slate-900 font-medium" onclick="filterCalendar('copasst', this)" type="button">COPASST</button>
<button class="px-2.5 py-1 rounded text-slate-600 hover:text-slate-900 font-medium" onclick="filterCalendar('capacitacion', this)" type="button">Capacitaciones</button>
</div>
<!-- Month Selector -->
<div class="flex items-center gap-1 bg-white border border-slate-200 rounded-lg p-0.5">
<button aria-label="Mes anterior" class="p-1.5 text-slate-500 hover:text-slate-800 rounded" title="Mes Anterior">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
<span class="text-xs font-semibold px-2 text-slate-700">Mayo 2025</span>
<button aria-label="Mes siguiente" class="p-1.5 text-slate-500 hover:text-slate-800 rounded" title="Mes Siguiente">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
</div>
</div>
</div>
